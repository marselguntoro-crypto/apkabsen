# Konfigurasi Lingkungan SIAP (Sistem Informasi Administrasi Presensi)
# Salin file ini menjadi .env jika ingin mengubah pengaturan default

APP_NAME="SIAP"
APP_FULL_NAME="Sistem Informasi Administrasi Presensi"
APP_VERSION="1.0.0-tahap1"
APP_ENV="development"

# Kredensial Awal Seed Admin (Hanya digunakan saat inisialisasi awal database)
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="Admin@SIAP2025"
INITIAL_ADMIN_NAME="Administrator Utama"

INITIAL_OPERATOR_USERNAME="operator"
INITIAL_OPERATOR_PASSWORD="Operator@SIAP2025"
INITIAL_OPERATOR_NAME="Petugas Presensi"

# Konfigurasi Lokasi Database (Opsional, default otomatis: data/database/siap_presensi.db)
# DB_PATH="data/database/siap_presensi.db"
